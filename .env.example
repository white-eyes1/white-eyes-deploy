# 복사해서 쓴다: cp .env.example .env  (값은 .env에만 채우고 커밋하지 않는다)

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=white_eyes
# 앱별 DB 계정(white_eyes_admin, white_eyes_user)의 비밀번호. MySQL 볼륨을 처음 만들 때만 적용된다
ADMIN_DB_PASSWORD=
USER_DB_PASSWORD=

# 관리자 앱·분석 서버·nginx가 같은 값을 쓴다. 32자 이상, 영문·숫자만(nginx 설정 파일에 그대로 들어간다)
INTERNAL_API_TOKEN=

# 최고 관리자 최초 등록(FNC-A-001, 관리자 앱 첫 실행 때 한 번)
SUPER_ADMIN_LOGIN_ID=
SUPER_ADMIN_INITIAL_PASSWORD=

# ---- 선택(주석을 풀면 기본값 대신 쓴다) ----
# HTTP_PORT=80
# 이 컴퓨터에서 MySQL에 붙는 포트(bootRun·IDE용). 3306을 다른 MySQL이 쓰고 있으면 바꾼다
# MYSQL_PORT=3306
# LOG_LEVEL=DEBUG
# FLASK_LOG_LEVEL=INFO
# DETECTOR=visdrone
# YOLO_WEIGHTS_FILE=visdrone-yolov8m.pt
# 저장소 위치(기본: 이 폴더 옆)
# SPRING_DIR=../white-eyes-spring
# FLASK_DIR=../white-eyes-flask

# 앱 설정(임계값·보관 일수·분석 입력 크기 등)은 여기가 아니라 env/spring.env, env/flask.env에 둔다(README '앱 설정 바꾸기')
